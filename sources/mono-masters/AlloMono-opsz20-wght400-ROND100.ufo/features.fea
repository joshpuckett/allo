feature calt {
  lookup mono3_step1 {
    ignore sub [less hyphen greater] less' hyphen greater;
    ignore sub less' hyphen greater [less hyphen greater];
    sub less' hyphen greater by less.larrow;

    ignore sub [less equal greater] less' equal greater;
    ignore sub less' equal greater [less equal greater];
    sub less' equal greater by less.dlarrow;

    ignore sub [hyphen less] hyphen' hyphen greater;
    ignore sub hyphen' hyphen greater [greater hyphen];
    sub hyphen' hyphen greater by hyphen.rarrow;

    ignore sub [less exclam] less' hyphen hyphen;
    ignore sub less' hyphen hyphen [hyphen greater];
    sub less' hyphen hyphen by less.larrow;

    ignore sub exclam exclam' equal equal;
    ignore sub exclam' equal equal equal;
    sub exclam' equal equal by exclam.neq3;

    ignore sub [equal exclam] equal' equal equal;
    ignore sub equal' equal equal equal;
    sub equal' equal equal by equal.eq3_l;
  } mono3_step1;

  lookup mono3_step2 {
    sub less.larrow hyphen' greater by hyphen.conn;
    sub less.dlarrow equal' greater by equal.dconn;
    sub hyphen.rarrow hyphen' greater by hyphen.conn;
    sub less.larrow hyphen' hyphen by hyphen.conn;
    sub exclam.neq3 equal' equal by equal.neq3_m;
    sub equal.eq3_l equal' equal by equal.eq3_m;
  } mono3_step2;

  lookup mono3_step3 {
    sub less.larrow hyphen.conn greater' by greater.rarrow;
    sub less.dlarrow equal.dconn greater' by greater.drarrow;
    sub hyphen.rarrow hyphen.conn greater' by greater.rarrow;
    sub less.larrow hyphen.conn hyphen' by hyphen.larrow;
    sub exclam.neq3 equal.neq3_m equal' by equal.eq3_r;
    sub equal.eq3_l equal.eq3_m equal' by equal.eq3_r;
  } mono3_step3;

  lookup mono2_step1 {
    ignore sub [hyphen less] hyphen' greater;
    ignore sub hyphen' greater [greater hyphen];
    sub hyphen' greater by hyphen.rarrow;

    ignore sub [less exclam] less' hyphen;
    ignore sub less' hyphen [hyphen greater];
    sub less' hyphen by less.larrow;

    ignore sub [equal less] equal' greater;
    ignore sub equal' greater [greater equal];
    sub equal' greater by equal.rarrow;

    ignore sub exclam exclam' equal;
    ignore sub exclam' equal equal;
    sub exclam' equal by exclam.neq;

    ignore sub [equal exclam] equal' equal;
    ignore sub equal' equal equal;
    sub equal' equal by equal.eq_l;

    ignore sub less less' equal;
    ignore sub less' equal [equal greater];
    sub less' equal by less.leq;

    ignore sub greater greater' equal;
    ignore sub greater' equal [equal greater];
    sub greater' equal by greater.geq;
  } mono2_step1;

  lookup mono2_step2 {
    sub hyphen.rarrow greater' by greater.rarrow;
    sub less.larrow hyphen' by hyphen.larrow;
    sub equal.rarrow greater' by greater.drarrow;
    sub exclam.neq equal' by equal.neq;
    sub equal.eq_l equal' by equal.eq_r;
    sub less.leq equal' by equal.leq;
    sub greater.geq equal' by equal.geq;
  } mono2_step2;
} calt;

feature case {
  sub @CASE_IN by @CASE_OUT;
} case;

feature sups {
  sub @FIG by @SUPS;
} sups;

feature subs {
  sub @FIG by @SUBS;
} subs;

feature numr {
  sub @FIG by @NUMR;
} numr;

feature dnom {
  sub @FIG by @DNOM;
} dnom;

feature frac {
  lookup fracBar {
    ignore sub slash @FIG slash';
    ignore sub slash @FIG @FIG slash';
    ignore sub slash @FIG @FIG @FIG slash';
    ignore sub slash @FIG @FIG @FIG @FIG slash';
    ignore sub slash' @FIG slash;
    ignore sub slash' @FIG @FIG slash;
    ignore sub slash' @FIG @FIG @FIG slash;
    ignore sub slash' @FIG @FIG @FIG @FIG slash;
    sub @FIG slash' @FIG by fraction;
  } fracBar;
  lookup fracNumr { rsub @FIG' [fraction @NUMR] by @NUMR; } fracNumr;
  lookup fracDnom { sub [fraction @DNOM] @FIG' by @DNOM; } fracDnom;
} frac;

feature tnum {
  sub @FIG by [zero.tf one.tf two.tf three.tf four.tf five.tf six.tf seven.tf eight.tf nine.tf];
  sub zero.slash by zero.tf.slash;
  sub zero.dot by zero.tf.dot;
} tnum;

feature zero {
  sub zero by zero.slash;
  sub zero.tf by zero.tf.slash;
} zero;

feature ss01 {
  featureNames { name "Single-story a"; };
  sub a by a.1;
  sub aacute by aacute.1;
  sub abreve by abreve.1;
  sub acircumflex by acircumflex.1;
  sub adieresis by adieresis.1;
  sub agrave by agrave.1;
  sub amacron by amacron.1;
  sub aogonek by aogonek.1;
  sub aring by aring.1;
  sub atilde by atilde.1;
  sub adotbelow by adotbelow.1;
  sub ahookabove by ahookabove.1;
  sub abreveacute by abreveacute.1;
  sub abrevegrave by abrevegrave.1;
  sub abrevehookabove by abrevehookabove.1;
  sub abrevetilde by abrevetilde.1;
  sub abrevedotbelow by abrevedotbelow.1;
  sub acircumflexacute by acircumflexacute.1;
  sub acircumflexgrave by acircumflexgrave.1;
  sub acircumflexhookabove by acircumflexhookabove.1;
  sub acircumflextilde by acircumflextilde.1;
  sub acircumflexdotbelow by acircumflexdotbelow.1;
} ss01;

feature ss02 {
  featureNames { name "Disambiguation"; };
  sub l by l.ss02;
  sub lacute by lacute.ss02;
  sub lcaron by lcaron.ss02;
  sub lcommaaccent by lcommaaccent.ss02;
  sub ldot by ldot.ss02;
  sub lslash by lslash.ss02;
  sub I by I.1;
  sub Iacute by Iacute.1;
  sub Ibreve by Ibreve.1;
  sub Icircumflex by Icircumflex.1;
  sub Idieresis by Idieresis.1;
  sub Idotaccent by Idotaccent.1;
  sub Igrave by Igrave.1;
  sub Imacron by Imacron.1;
  sub Iogonek by Iogonek.1;
  sub Itilde by Itilde.1;
  sub Idotbelow by Idotbelow.1;
  sub Ihookabove by Ihookabove.1;
  sub zero by zero.slash;
  sub zero.tf by zero.tf.slash;
  sub one by one.foot;
  sub one.tf by one.foot.tf;
} ss02;

feature ss03 {
  featureNames { name "Open figures"; };
  sub four by four.ss01;
  sub six by six.ss01;
  sub nine by nine.ss01;
  sub four.tf by four.tf.ss01;
  sub six.tf by six.tf.ss01;
  sub nine.tf by nine.tf.ss01;
} ss03;

feature cv01 {
  cvParameters {
    FeatUILabelNameID { name "Footed 1"; };
  };
  sub one by one.foot;
  sub one.tf by one.foot.tf;
} cv01;

feature cv02 {
  cvParameters {
    FeatUILabelNameID { name "Slashed zero"; };
  };
  sub zero by zero.slash;
  sub zero.tf by zero.tf.slash;
} cv02;

feature cv03 {
  cvParameters {
    FeatUILabelNameID { name "Tailed l"; };
  };
  sub l by l.ss02;
  sub lacute by lacute.ss02;
  sub lcaron by lcaron.ss02;
  sub lcommaaccent by lcommaaccent.ss02;
  sub ldot by ldot.ss02;
  sub lslash by lslash.ss02;
} cv03;

feature cv04 {
  cvParameters {
    FeatUILabelNameID { name "Serifed I"; };
  };
  sub I by I.1;
  sub Iacute by Iacute.1;
  sub Ibreve by Ibreve.1;
  sub Icircumflex by Icircumflex.1;
  sub Idieresis by Idieresis.1;
  sub Idotaccent by Idotaccent.1;
  sub Igrave by Igrave.1;
  sub Imacron by Imacron.1;
  sub Iogonek by Iogonek.1;
  sub Itilde by Itilde.1;
  sub Idotbelow by Idotbelow.1;
  sub Ihookabove by Ihookabove.1;
} cv04;

feature cv05 {
  cvParameters {
    FeatUILabelNameID { name "Dotted zero"; };
  };
  sub zero by zero.dot;
  sub zero.plain by zero.dot;
  sub zero.tf by zero.tf.dot;
  sub zero.slash by zero.dot;
  sub zero.tf.slash by zero.tf.dot;
} cv05;

feature cv06 {
  cvParameters {
    FeatUILabelNameID { name "Plain zero"; };
  };
  sub zero by zero.plain;
  sub zero.slash by zero.plain;
  sub zero.dot by zero.plain;
  sub zero.tf by zero.plain;
  sub zero.tf.slash by zero.plain;
  sub zero.tf.dot by zero.plain;
} cv06;

feature cv07 {
  cvParameters {
    FeatUILabelNameID { name "Serifless I"; };
  };
  sub I by I.sans;
  sub I.1 by I.sans;
} cv07;
